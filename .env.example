# Copy to .env (not committed) — consumed by docker-compose.yml.

# Bearer token(s) accepted by the backend (CSV to allow rotation without
# downtime). Must match AEGIS_BACKEND_TOKEN on the frontend side
# (frontend/.env.local).
AEGIS_BACKEND_TOKENS=changeme-dev-token

# Ollama — leave as-is if Ollama runs on the host machine.
OLLAMA_URL=http://host.docker.internal:11434

# Qdrant (the "qdrant" service in docker-compose, no need to change it locally).
# Also works pointed at a remote/managed instance (e.g. Qdrant Cloud) — set
# QDRANT_API_KEY too if that instance requires one. See docs/rag.md.
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# Origins allowed to call the backend (CORS), CSV. The local default is
# fine as-is; in prod, point it at the real Vercel origin — see docs/deployment.md.
AEGIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — Cloudflare Tunnel (see docker-compose.yml and docs/deployment.md)
# CLOUDFLARE_TUNNEL_TOKEN=
