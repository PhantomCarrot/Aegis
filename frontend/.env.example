# Copy to .env.local (not committed) for local dev.
# SERVER variables only — never a NEXT_PUBLIC_ prefix here: the browser
# must never see the backend's URL or token (see docs/architecture.md and
# app/api/backend/[...path]/route.ts).

# Use 127.0.0.1, not localhost: on a machine with other local port-forwards
# (an SSH tunnel, another dev server, ...) bare "localhost" can resolve to
# ::1 first and silently hit the wrong service on the same port.
AEGIS_BACKEND_URL=http://127.0.0.1:8765
AEGIS_BACKEND_TOKEN=changeme-dev-token
